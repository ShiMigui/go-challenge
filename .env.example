# Ambiente local. Valores de exemplo, sem segredos reais.
# O `make setup` copia este arquivo para .env, que nao e versionado.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8080
SERVICE_LOG_LEVEL=debug
STARTUP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Banco de dados (prefixo DB)
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wagering
DB_USER=wagering
DB_PASSWORD=wagering
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# ---------------------------------------------------------------------------
# Mensageria: AWS via LocalStack (prefixos AWS e SQS)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_SQS=http://localstack:4566

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_QUEUE_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_VISIBILITY_TIMEOUT=30s
SQS_MAX_RECEIVE_COUNT=3
SQS_WAIT_TIME=20s
SQS_MAX_MESSAGES=10

# ---------------------------------------------------------------------------
# IdP: OAuth 2.0 / OIDC (prefixo OIDC)
# ---------------------------------------------------------------------------
OIDC_ISSUER_URL=http://keycloak:8080/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_CLIENT_ID=wagering-api
OIDC_CLIENT_SECRET=change-me-local-only
OIDC_PROVIDER_CLAIM=provider_id
OIDC_ROLES_CLAIM=resource_access

OIDC_ADMIN_USER=admin
OIDC_ADMIN_PASSWORD=admin

# Identidades de teste usadas nos fluxos autenticados.
OIDC_TEST_PROVIDER_A_CLIENT_ID=provider-a
OIDC_TEST_PROVIDER_A_CLIENT_SECRET=provider-a-secret
OIDC_TEST_PROVIDER_B_CLIENT_ID=provider-b
OIDC_TEST_PROVIDER_B_CLIENT_SECRET=provider-b-secret
OIDC_TEST_INTERNAL_CLIENT_ID=wagering-internal
OIDC_TEST_INTERNAL_CLIENT_SECRET=wagering-internal-secret
